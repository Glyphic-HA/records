# Copy to .env and fill in. Never commit .env.

# Your Discogs username (the one in your profile URL).
DISCOGS_USERNAME=

# Personal access token: https://www.discogs.com/settings/developers -> "Generate new token"
DISCOGS_TOKEN=

# Optional: require this value in an X-Edit-Token header to change bin locations.
# Leave blank on a trusted home network.
RC_EDIT_TOKEN=

# Optional: set to 0 to stop the web server fetching missing covers from Discogs on demand.
# RC_FETCH_MISSING_IMAGES=1

# Optional: keep data somewhere other than ./data
# RC_DATA_DIR=/home/pi/record-data
